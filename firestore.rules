rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['name', 'neighborhood', 'rating', 'comment', 'createdAt'])
        && data.keys().hasOnly(['name', 'neighborhood', 'rating', 'comment', 'createdAt', 'verified'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 60
        && data.neighborhood is string && data.neighborhood.size() >= 2 && data.neighborhood.size() <= 60
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() >= 3 && data.comment.size() <= 500
        && (data.createdAt is timestamp || (data.createdAt is string && data.createdAt.size() <= 64))
        && (!('verified' in data) || data.verified is bool);
    }

    // Public Customer Reviews for Gás Brasil
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isValidId(reviewId) && isValidReview(incoming());
      allow update, delete: if false;
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
